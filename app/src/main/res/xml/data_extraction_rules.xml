<?xml version="1.0" encoding="utf-8"?>
<!--
    MallowLink – Data Extraction Rules
    We explicitly EXCLUDE all sensitive data from cloud backups.
    The database contains user document embeddings and chat history
    which must stay on-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device-to-device transfers but not cloud -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
